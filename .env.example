# Server
SERVER_PORT=5501

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Firebase Google sign-in (project id only; no service account needed)
FIREBASE_PROJECT_ID=your-firebase-project-id
