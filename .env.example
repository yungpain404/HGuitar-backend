# Database
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=GUITAR_LEARNING_DB;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=YourStrong!Passw0rd

# JWT
JWT_SECRET=replace-with-a-strong-256-bit-secret-key-before-deploying
